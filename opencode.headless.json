{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "deny",
      "ls*": "allow",
      "mkdir*": "allow",
      "git add *": "allow",
      "git commit*": "allow",
      "git checkout*": "allow",
      "git push*": "deny",
      "git rebase*": "deny",
      "gh pr create*": "deny",
      "gh pr merge*": "deny",
      "gh issue create*": "deny",
      "gh issue comment*": "deny",
      "gh issue edit*": "deny",
      "gh issue*": "deny"
    },
    "question": "deny"
  }
}
